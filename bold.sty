% Single column paper style for BOLD documents.
% Layout follows the ICML 2025 style file.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bold}[2026/09/08 BOLD document style]

% ---------------------------------------------------------------- packages
\RequirePackage[margin=3.1cm]{geometry}
\RequirePackage{amsmath,amssymb,bm}   % before the font, which picks the maths glyphs
\RequirePackage[T1]{fontenc}          % Times small caps exist only in T1
\RequirePackage{mathptmx}             % Times text and Times maths
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{booktabs}
\RequirePackage{float}
\RequirePackage{algorithm}
\RequirePackage[noend]{algpseudocode}
\RequirePackage[labelfont=bf,labelsep=period,font=small]{caption}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tocloft}
\usetikzlibrary{decorations.pathreplacing,patterns}
\graphicspath{{assets/}}                % documents build from the repo root

% ---------------------------------------------------------------- palette
\definecolor{Link}{HTML}{1A4E8A}      % hyperlinks
\definecolor{Ink}{HTML}{1A1A1A}       % figure text and rules
\definecolor{Data}{HTML}{2B6CB0}      % the data side of a diagram
\definecolor{Noisy}{HTML}{B03060}     % the noise side of a diagram
\definecolor{Acc}{HTML}{2F855A}       % accent
\definecolor{Faint}{HTML}{7A7A7A}     % secondary text
\definecolor{Wash}{HTML}{B4BCC6}      % light fills

% The BOLD blue ramp, taken from the marks, darkest first.
\definecolor{Blue1}{HTML}{012956}
\definecolor{Blue2}{HTML}{5273AB}
\definecolor{Blue3}{HTML}{779FDD}
\definecolor{Blue4}{HTML}{AECBEB}

\RequirePackage[colorlinks=true,allcolors=Link]{hyperref}

% ---------------------------------------------------------------- headings
\titleformat{\section}{\large\bfseries\raggedright}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries\raggedright}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\scshape\raggedright}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{9pt plus 2pt}{1.5pt}
\titlespacing*{\subsection}{0pt}{7.5pt plus 1pt}{1pt}
\titlespacing*{\subsubsection}{0pt}{6pt plus 1pt}{1pt}
\titleformat{\part}[display]{\raggedright\normalsize\bfseries}{\partname\ \thepart}{2pt}{\LARGE\bfseries}
\titlespacing*{\part}{0pt}{6pt}{10pt}
\setcounter{secnumdepth}{3}

% ------------------------------------------------------ text and displays
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\abovedisplayskip}{7pt plus 2pt minus 5pt}
\setlength{\belowdisplayskip}{7pt plus 2pt minus 5pt}
\linespread{1.06}

% ------------------------------------------------------------------ floats
% A figure dense document needs looser limits than the defaults.
\setcounter{topnumber}{3}
\setcounter{totalnumber}{4}
\renewcommand{\topfraction}{0.92}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.75}
\setlength{\intextsep}{7pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\abovecaptionskip}{5pt}
\setlength{\belowcaptionskip}{0pt}

% -------------------------------------------------------------- algorithms
\floatstyle{ruled}
\restylefloat{algorithm}
\renewcommand{\algorithmicrequire}{\textbf{Input}}
\renewcommand{\algorithmicensure}{\textbf{Output}}
\algrenewcommand\algorithmicindent{0.9em}
\algrenewcommand{\alglinenumber}[1]{\footnotesize#1.}

% ---------------------------------------------------------------- contents
\setcounter{tocdepth}{1}
\renewcommand{\cfttoctitlefont}{\normalsize\bfseries}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{5pt}
\renewcommand{\cftsecfont}{\small}
\renewcommand{\cftsecpagefont}{\small}
\renewcommand{\cftpartfont}{\normalsize}
\renewcommand{\cftpartpagefont}{\normalsize}
\renewcommand{\cftpartleader}{\normalfont\cftdotfill{\cftdotsep}}
\setlength{\cftbeforesecskip}{1pt}
\setlength{\cftbeforepartskip}{3pt}
\setlength{\cftparskip}{0pt}

% Framed contents, sized to sit inside the text block.
\newcommand{\boldcontents}{%
  \begin{center}
    \setlength{\fboxrule}{0.5pt}\setlength{\fboxsep}{9pt}%
    \fcolorbox{Faint!45}{white}{%
      \begin{minipage}{0.86\linewidth}
        {\small\tableofcontents}
      \end{minipage}}%
  \end{center}
  \vspace{8pt}
  \thispagestyle{fancy}   % \tableofcontents resets the first page to plain
}

% ------------------------------------------------------------------ footer
\newcommand{\boldstarted}{}
\newcommand{\started}[1]{\renewcommand{\boldstarted}{Started #1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\color{Faint}\boldstarted}
\fancyfoot[C]{\footnotesize\thepage}

% ------------------------------------------------------------- title block
\newcommand{\lab}{British Open Ended Discovery Lab}

\makeatletter
\renewcommand{\maketitle}{%
  \thispagestyle{fancy}
  \begin{center}
    \raisebox{-0.30\height}{\includegraphics[height=1.6cm]{bold-mark.png}}%
    \hspace{11pt}{\LARGE\bfseries\@title}

    \vspace{15pt}
    {\large\@author}\\[5pt]
    {\normalsize\raisebox{-0.22\height}{\includegraphics[height=0.48cm]{bold-word.png}}%
     \hspace{5pt}\lab}
  \end{center}
  \vspace{10pt}
}
\makeatother

\endinput
